#!/usr/bin/env node
// Этот скрипт запускает наш веб-сервер

/**
 * Подключаем нужные модули
 */

// Берем наше основное приложение Express из файла app.js
var app = require('../app');

// Модуль для красивого вывода сообщений в консоль
var debug = require('debug')('runner:server');

// Встроенный в Node.js модуль для работы с HTTP
var http = require('http');

/**
 * Настраиваем порт для сервера
 */

// Определяем на каком порту будем работать:
// - если в настройках указан PORT=8080, то берем его
// - если нет, то используем порт 3000
var port = normalizePort(process.env.PORT || '3000');

// Сообщаем Express на каком порту работать
app.set('port', port);

/**
 * Создаем HTTP сервер
 */

// Создаем сервер и говорим ему использовать наше Express приложение
// Теперь все запросы будут обрабатываться через Express
var server = http.createServer(app);

/**
 * Запускаем сервер слушать указанный порт
 */

// Запускаем сервер - теперь он ждет подключений на указанном порту
server.listen(port);

// Настраиваем обработчики событий:

// Если будет ошибка при запуске - вызови функцию onError
server.on('error', onError);

// Когда сервер успешно запустится - вызови функцию onListening
server.on('listening', onListening);

/**
 * Функция для правильной обработки номера порта
 * Порт может быть числом (3000) или строкой ('3000')
 */
function normalizePort(val) {
  // Пытаемся преобразовать значение в число
  var port = parseInt(val, 10);

  // Если не получилось (это не число)
  if (isNaN(port)) {
    // Значит это что-то другое (например, специальный канал связи)
    return val; // Возвращаем как есть
  }

  // Если получилось число и оно положительное
  if (port >= 0) {
    return port; // Возвращаем номер порта
  }

  // Если что-то пошло не так
  return false;
}

/**
 * Функция-обработчик ошибок при запуске сервера
 */
function onError(error) {
  // Если ошибка не связана с запуском сервера
  if (error.syscall !== 'listen') {
    throw error; // Просто выбрасываем ошибку дальше
  }

  // Готовим понятное описание порта для сообщения об ошибке
  var bind = typeof port === 'string'
    ? 'Канал ' + port   // Если порт - строка
    : 'Порт ' + port;   // Если порт - число

  // Обрабатываем разные типы ошибок:
  switch (error.code) {
    case 'EACCES':
      // Ошибка: нет прав доступа к порту
      // Например, пытаемся использовать порт 80 без прав администратора
      console.error(bind + ' требует прав администратора');
      process.exit(1); // Завершаем программу
      break;
    case 'EADDRINUSE':
      // Ошибка: порт уже занят другим приложением
      console.error(bind + ' уже используется другим приложением');
      process.exit(1); // Завершаем программу
      break;
    default:
      // Для всех других ошибок - просто выбрасываем их
      throw error;
  }
}

/**
 * Функция которая вызывается когда сервер успешно запустился
 */
function onListening() {
  // Получаем информацию о том, на каком адресе работает сервер
  var addr = server.address();
  
  // Готовим сообщение для вывода в консоль
  var bind = typeof addr === 'string'
    ? 'канал ' + addr   // Если используется специальный канал
    : 'порт ' + addr.port; // Если используется сетевой порт
  
  // Выводим в консоль сообщение типа: "Слушаем на порту 3000"
  debug('Listening on ' + bind);
}